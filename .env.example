VOLC_ACCESS_KEY=your_volc_access_key
VOLC_SECRET_KEY=your_volc_secret_key
ARK_API_KEY=your_ark_api_key
ARK_ENDPOINT_ID=your_ark_endpoint_id
RTC_APP_ID=your_rtc_app_id
RTC_APP_KEY=your_rtc_app_key
RTC_TOKEN_MODE=auto
RTC_DEBUG_PRINT_TOKEN=false
RTC_DYNAMIC_SESSION=true
RTC_OPENAPI_TIMEOUT=30
VOICE_CONFIRM_MODE=true
RTC_TOKEN=your_optional_rtc_temp_token
RTC_ROOM_ID=XzyDemoRoom
RTC_USER_ID=XzyTester
ASR_APP_ID=your_asr_app_id
TTS_APP_ID=your_tts_app_id
TTS_SPEED_RATIO=1.5
SERVER_URL=https://your-public-callback-url.example.com

# Lightweight context compression for text chat.
CONTEXT_MANAGER_ENABLED=true
CONTEXT_BUDGET_TOKENS=6000
CONTEXT_T2_THRESHOLD=0.50
CONTEXT_T3_THRESHOLD=0.75
CONTEXT_T4_THRESHOLD=0.90
CONTEXT_T5_THRESHOLD=0.95
CONTEXT_RECENT_ROUNDS=6
CONTEXT_MAX_MESSAGE_CHARS=1200
CONTEXT_SESSION_ID=text_default
CONTEXT_DEMO_MODE=false

# Optional for replacing the local mock RAG demo later.
VOLC_ACCOUNT_ID=your_volc_account_id
KB_COLLECTION_NAME=your_collection_name
KB_PROJECT_NAME=default
